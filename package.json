{
  "name": "xie-agent",
  "version": "0.9.0",
  "description": "小说写作 CLI Agent - 终端里的写作搭档",
  "type": "module",
  "bin": {
    "xie": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/xie-agent/xie.exe",
    "test": "bun test tests/"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
